{
  "name": "dsh-directions",
  "version": "0.2.1",
  "description": "Fork one DSH conversation into independent direction branches and synthesize the chosen results back into the main thread",
  "type": "module",
  "license": "MIT",
  "author": "zhannweii",
  "homepage": "https://github.com/zhannweii/dsh-directions#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhannweii/dsh-directions.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "conversation",
    "branch",
    "fork",
    "side-quest",
    "context"
  ],
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.2 || >=0.2.1-rc.2 || >=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
